<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- La clave del Keystore no viaja con la copia: el dato restaurado sería ilegible. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="taskeer_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="taskeer_session.xml" />
    </device-transfer>
</data-extraction-rules>
